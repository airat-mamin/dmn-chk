REDIS_URL=redis://redis:6379/0

# DoH endpoint for DNS prefilter
DOH_URL=https://cloudflare-dns.com/dns-query

# RDAP base for .ru
RDAP_URL=https://rdap.nic.ru/domain

# WHOIS server for .ru
WHOIS_HOST=whois.tcinet.ru
WHOIS_PORT=43

# Rate limits (requests per second) — conservative defaults
DOH_RPS=50
RDAP_RPS=3
WHOIS_RPS=0.5

# HTTP timeouts (seconds)
HTTP_TIMEOUT=10
WHOIS_TIMEOUT=10

# Batch processing
BATCH_MAX_SIZE=10000
WORKER_CONCURRENCY=32

# Cache TTLs (seconds)
TTL_FREE=300
TTL_REGISTERED=86400
TTL_PENDING=60
TTL_ERROR=300
TTL_UNKNOWN=60
TTL_DOH=600

LOG_LEVEL=INFO
